# ===================================================================
# Telegram Auto Stars bot - muhit o'zgaruvchilari namunasi
# Ushbu faylni .env deb nomlab, qiymatlarni o'z qiymatlaringizga
# almashtiring. HECH QACHON .env faylini gitga push qilmang!
# ===================================================================

# --- Asosiy ---
# BotFather (@BotFather) dan olingan bot tokeni
BOT_TOKEN=9222246824:AAHOxV2fZe_0nhDfrqhlNsg3OMENmEs_NwU

# Admin foydalanuvchilar Telegram ID lari (vergul bilan ajrating)
ADMIN_IDS=6816038229,987654321

# Bosh administrator ID (huquqlar tepasi)
SUPER_ADMIN_ID=123456789

# --- Majburiy obuna kanali ---
# @ belgisiz username yoki kanal linki: my_channel
REQUIRED_CHANNEL=
# Kanalning chat id raqami (bot kanalga admin qo'shilsa to'ldiriladi)
REQUIRED_CHANNEL_ID=-1001234567890

# --- To'lovlar ---
# Telegram Stars (XTR) orqali qabul qilish uchun provider token
# @BotFather -> Payments -> Get provider token (Stars turini tanlang)
PAYMENTS_PROVIDER_TOKEN=
# Karta orqali (ruchka) to'lov uchun ko'rsatiladigan karta raqami
PAYMENT_CARD=9860 0000 0000 0000

# --- API (@Apilarimbot) ---
# Avtomatik sotib olish API sozlamalari
STARS_API_BASE_URL=
STARS_API_KEY=
# API qayta chaqiruv (webhook) uchun maxfiy kalit
API_CALLBACK_SECRET=change-me-strong-secret

# --- Ma'lumotlar bazasi ---
DB_PATH=data/stars.db

# --- WebApp admin paneli ---
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Vaqt mintaqasi ---
TZ=Asia/Tashkent
